# ==============================================================================
# Ndi-Fi Protocol - Environment Configuration
# ==============================================================================
# Copy this file to .env and adjust values for your local or testnet deployment:
#   cp .env.example .env
#
# DO NOT commit real secrets or private keys to source control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. EVM / Foundry Backend Configuration
# ------------------------------------------------------------------------------
# Anvil local RPC endpoint and port
ETH_RPC_URL=http://localhost:8545
ANVIL_PORT=8545
CHAIN_ID=31337

# Default Anvil Account #0 private key (Public test key - DO NOT use on mainnet)
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Etherscan verification API key (optional for local development)
ETHERSCAN_API_KEY=

# Deployed EVM Contract Addresses (populated after deployment)
NDI_VAULT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
NDI_LENDING_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512
NDI_STAKING_ADDRESS=0x9fE46736679d2D9a65F0992F2272dE9f3c7fa6e0
NDI_POINT_ADDRESS=0xCf7Ed3AccA5a467e9e704C703E8D87F634fB0Fc9

# ------------------------------------------------------------------------------
# 2. Stellar (Soroban) Configuration
# ------------------------------------------------------------------------------
# Target network: testnet | local | futurenet
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Local Stellar CLI identity name (keys stored outside repo in ~/.config/stellar)
STELLAR_IDENTITY=ndi-deployer

# Deployed Stellar Contract IDs (from stellar/deployments/testnet.json)
NDI_TOKEN_ID=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC
NDI_LENDING_ID=CAPS3G3J2P5L4L27F5O662NZW5KVE5GUGHRD6Y7WFL7ZTRXNDIFILEND
NDI_STAKING_ID=CBZ72V2Q7K27Y5W4M6K7G4W3NZP2H5R7F5L6Z4NDIFISTAKINGPOOL

# Stellar Contract Parameters (in stroops: 1 unit = 10,000,000 stroops)
LENDING_DEPOSIT_CAP=1000000000000
LENDING_INTEREST_RATE=500000
STAKING_REWARD_RATE=1000000
STAKING_COOLDOWN_SECONDS=1814400

# ------------------------------------------------------------------------------
# 3. Frontend & Client UI Configuration (NEXT_PUBLIC_*)
# ------------------------------------------------------------------------------
# Client-side environment variables exposed to the web frontend:
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_NAME="Ndi-Fi Protocol"
NEXT_PUBLIC_DEFAULT_CHAIN_ID=31337
NEXT_PUBLIC_ETH_RPC_URL=http://localhost:8545

# Stellar client configuration
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Frontend Contract References
NEXT_PUBLIC_NDI_VAULT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
NEXT_PUBLIC_NDI_LENDING_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512
NEXT_PUBLIC_NDI_STAKING_ADDRESS=0x9fE46736679d2D9a65F0992F2272dE9f3c7fa6e0
NEXT_PUBLIC_NDI_POINT_ADDRESS=0xCf7Ed3AccA5a467e9e704C703E8D87F634fB0Fc9

NEXT_PUBLIC_NDI_TOKEN_ID=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC
NEXT_PUBLIC_NDI_LENDING_ID=CAPS3G3J2P5L4L27F5O662NZW5KVE5GUGHRD6Y7WFL7ZTRXNDIFILEND
NEXT_PUBLIC_NDI_STAKING_ID=CBZ72V2Q7K27Y5W4M6K7G4W3NZP2H5R7F5L6Z4NDIFISTAKINGPOOL

# Frontend dev server port
PORT=3000
FRONTEND_PORT=3000
